# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → Data API / API Keys).
#
# Apenas chaves públicas aqui: tudo com prefixo EXPO_PUBLIC_ é embutido no
# bundle do app. Nunca coloque service_role key ou client secrets neste arquivo.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
