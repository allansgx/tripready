{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Os testes de regra rodam direto no Node (`node --test`), que resolve o
    // arquivo pelo caminho real — daí o import terminar em `.ts`.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // As Edge Functions rodam em Deno, com outro runtime e outros imports. Elas
  // têm a própria checagem em `supabase/functions/deno.json` (`pnpm
  // functions:check`) — compilá-las junto com o app só produziria erro falso.
  "exclude": ["supabase/functions"]
}
